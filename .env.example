# Client/app API endpoint used by the mobile app when requesting a premium AI reading.
EXPO_PUBLIC_AI_READING_API_URL=https://your-netlify-site.example/api/premium-reading

# Client/app entitlement name to look for in RevenueCat customer info.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# Client/app RevenueCat Android public SDK key. This is safe to ship in the app bundle.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_PUBLIC_ANDROID_KEY

# Server-only Netlify/OpenAI/RevenueCat settings. Do not prefix these with EXPO_PUBLIC.

# Server-only OpenAI key used by Netlify to call OpenAI. Never ship this in the app.
OPENAI_API_KEY=sk_YOUR_OPENAI_KEY

# OpenAI model used for premium reading generation.
OPENAI_READING_MODEL=gpt-5.4-mini

# Hard cap on generated output size for each OpenAI premium reading response.
OPENAI_READING_MAX_OUTPUT_TOKENS=1800

# Server-only RevenueCat secret key used by Netlify to verify subscriber entitlements.
REVENUECAT_SECRET_API_KEY=YOUR_REVENUECAT_SECRET_KEY

# RevenueCat entitlement that grants access to premium AI readings.
REVENUECAT_ENTITLEMENT_ID=premium

# Browser CORS allowlist for the premium-reading endpoint. Use comma-separated origins, not API URLs.
# Example for local browser testing: https://your-netlify-site.example,http://localhost:8081
AI_READING_ALLOWED_ORIGIN=https://your-netlify-site.example

# Global kill switch for premium AI readings. Set false to disable the endpoint without redeploying.
AI_READING_ENABLED=true

# Maximum premium AI readings per RevenueCat user/customer per day.
AI_READING_DAILY_USER_LIMIT=20

# Maximum premium AI readings across all users per day. Use 0 to disable the global cap.
AI_READING_DAILY_GLOBAL_LIMIT=0

# When true, returns a fake reading and skips OpenAI. Use only for testing/review environments.
AI_READING_MOCK_RESPONSE=false

# When true, archives sanitized user questions for later product/marketing analysis.
AI_READING_QUESTION_ARCHIVE_ENABLED=false

# When true, allows the server-only test bypass token to access premium readings.
ALLOW_AI_READING_TEST_ACCESS=false

# Server-only bearer token for controlled test access when ALLOW_AI_READING_TEST_ACCESS=true.
AI_READING_TEST_BYPASS_TOKEN=

# Server-only bearer token for the private archived-questions admin endpoint.
ADMIN_QUESTIONS_API_TOKEN=

# Browser CORS allowlist for private admin endpoints. Use comma-separated origins, not API URLs.
ADMIN_ALLOWED_ORIGIN=https://your-netlify-site.example

# When true, enables the reviewer access code endpoint and reviewer premium-reading access.
REVIEW_ACCESS_ENABLED=false

# Server-only code supplied to app reviewers. Accepted code receives a temporary reviewer token.
REVIEW_ACCESS_CODE=

# Browser CORS allowlist for the reviewer access endpoint. Use comma-separated origins, not API URLs.
REVIEW_ACCESS_ALLOWED_ORIGIN=https://your-netlify-site.example
